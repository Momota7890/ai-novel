    "build": "vite build && vite build --config vite.content.config.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "@types/node": "^22.10.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.4"
  }
}
